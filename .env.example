# Leave DATABASE_URL empty to run the read-only seeded demo.
DATABASE_URL=

# ElevenLabs Agents Platform + imported Twilio number.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Email delivery for completed daily progress reports.
RESEND_API_KEY=
DPR_FROM_EMAIL="FieldBrief <reports@example.com>"
DPR_HEAD_OFFICE_EMAIL=

# Protects the scheduled endpoint.
CRON_SECRET=

# Optional internal-dashboard access gate. Use SSO in front of the app for larger teams.
APP_USERNAME=
APP_PASSWORD=

# Absolute production origin, used for links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3010
